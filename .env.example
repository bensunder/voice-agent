# ---------------------------------------------------------------------------
# AI Sales Agent configuration. Copy to .env (deploy.sh does this for you).
# Secrets do NOT go here - they live in ./secrets/ (see deploy.sh).
# Values containing | or ; must stay quoted.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_COCKPIT_URL=https://cockpit.whyaidata.com
PUBLIC_TOOL_API_URL=https://sales-api.whyaidata.com

# --- Demo guardrails -------------------------------------------------------
# In demo mode only allowlisted numbers can be dialled (comma-separated E.164).
DEMO_MODE=true
DEMO_ALLOWLIST=+18015550123
COCKPIT_USERNAME=demo

# --- Business rules --------------------------------------------------------
COMPANY_NAME=Acme Wireless
PRODUCT_NAME=enterprise wireless service
BUSINESS_TIMEZONE=America/Denver
CALLING_WINDOW_START_HOUR=8
CALLING_WINDOW_END_HOUR=21
MEETING_MINUTES=30
WORKDAY_START_HOUR=9
WORKDAY_END_HOUR=17
# Sales reps: "upn|Display Name|TeamsUserObjectId;upn2|Name 2|id2"
SALES_REPS="rep1@benwhyaidata.onmicrosoft.com|Enterprise Specialist|"

# Price book (USD per line per month) and contract term
PRICE_ARPU_TIER1=38
PRICE_ARPU_TIER2=34
PRICE_ARPU_TIER3=30
PRICE_TERM_MONTHS=36
PRICE_MIN_LINES=100

# --- Microsoft Entra app registration (Graph + Dataverse + Foundry) --------
# Client secret goes in secrets/azure_client_secret
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Foundry voice agent + Teams Phone extensibility -----------------------
# e.g. https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=sales-qualifier
# Name of the AzureCommunicationServices project connection in Foundry
FOUNDRY_CONNECTION_NAME=
# Teams resource account object ID (GUID only, no 28:orgid: prefix)
TEAMS_RESOURCE_ACCOUNT_ID=

# --- Power Platform --------------------------------------------------------
# e.g. https://org1234abcd.crm.dynamics.com  (then run provision_dataverse)
DATAVERSE_URL=
DATAVERSE_PREFIX=cr
DATAVERSE_TABLE=cr_aicallqualifications
# Power Automate HTTP trigger URL goes in secrets/power_automate_webhook_url
